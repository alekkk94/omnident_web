---
import '../styles/global.css';
import { getTranslations, localizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/ui';
import { site } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const canonicalPath = localizedPath(lang);
const canonicalUrl = new URL(canonicalPath, Astro.site);
const ogImageUrl = new URL('/og-image.svg', Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: site.name,
  image: ogImageUrl.toString(),
  telephone: site.phone.display,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '10:00',
    closes: '19:00',
  },
  sameAs: [site.social.instagram, site.social.facebook],
  url: canonicalUrl.toString(),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="mk" href={new URL(localizedPath('mk'), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(localizedPath('en'), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath('mk'), Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang === 'mk' ? 'mk_MK' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--color-primary-hover);
    color: #ffffff;
    padding: 0.75rem 1.25rem;
    z-index: 1000;
    border-radius: 0 0 var(--radius-md) 0;
    font-weight: 600;
  }

  .skip-link:focus {
    left: 0;
  }
</style>
