---
import { getTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';
import { site } from '../../config/site';
import ArtPanel from '../ArtPanel.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section id="hero" class="hero">
  <div class="container hero-grid">
    <div class="hero-content">
      <span class="eyebrow reveal">{t.hero.eyebrow}</span>
      <h1 class="hero-headline reveal">
        {t.hero.headlineStart}<span class="accent">{t.hero.headlineAccent}</span>{t.hero.headlineEnd}
      </h1>
      <p class="hero-subline reveal">{t.hero.subline}</p>

      <div class="hero-ctas reveal">
        <a class="btn btn-primary" href="#contact">{t.hero.ctaPrimary}</a>
        <a class="btn btn-outline" href="#services">{t.hero.ctaSecondary}</a>
      </div>

      <div class="hero-proof reveal">
        <div class="proof-avatars" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="proof-text">
          <strong>{site.patients}</strong> {t.hero.badgePatients}
        </div>
      </div>
    </div>

    <div class="hero-media reveal">
      <ArtPanel icon="smile" ratio="4 / 5" />
      <div class="hero-badge hero-badge-rating">
        <span class="hero-badge-value">★ {site.rating.value.toFixed(1)}/{site.rating.max.toFixed(1)}</span>
        <span class="hero-badge-label">{t.hero.badgeRating}</span>
      </div>
      <div class="hero-badge hero-badge-patients">
        <span class="hero-badge-value">{site.patients}</span>
        <span class="hero-badge-label">{t.hero.badgePatients}</span>
      </div>
    </div>
  </div>

  <a href="#about" class="scroll-hint">
    <span>{t.hero.scrollHint}</span>
    <span class="scroll-hint-line"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -20%;
    left: 50%;
    width: 140%;
    height: 60%;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(201, 168, 101, 0.12), transparent 65%);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .hero-headline {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    margin-block: 1rem 1.25rem;
  }

  .hero-subline {
    max-width: 46ch;
    color: var(--color-ink-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .hero-proof {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 2.75rem;
  }

  .proof-avatars {
    display: flex;
  }

  .proof-avatars span {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-gold-bright), var(--color-gold));
    border: 2px solid var(--color-bg);
    margin-left: -10px;
  }

  .proof-avatars span:first-child {
    margin-left: 0;
  }

  .proof-text {
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }

  .proof-text strong {
    color: var(--color-ink);
  }

  .hero-media {
    position: relative;
  }

  .hero-badge {
    position: absolute;
    display: flex;
    flex-direction: column;
    background: rgba(21, 19, 16, 0.9);
    backdrop-filter: blur(10px);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    padding: 0.75rem 1.1rem;
    box-shadow: 0 12px 30px -12px rgba(0, 0, 0, 0.7);
  }

  .hero-badge-value {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-gold-bright);
  }

  .hero-badge-label {
    font-size: 0.7rem;
    color: var(--color-ink-muted);
    letter-spacing: 0.03em;
  }

  .hero-badge-rating {
    top: -1rem;
    left: -1rem;
  }

  .hero-badge-patients {
    bottom: -1rem;
    right: -1rem;
  }

  .scroll-hint {
    display: none;
    position: absolute;
    left: 50%;
    bottom: 0.5rem;
    transform: translateX(-50%);
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .scroll-hint-line {
    width: 1px;
    height: 32px;
    background: linear-gradient(var(--color-gold), transparent);
  }

  @media (min-width: 860px) {
    .scroll-hint {
      display: flex;
    }
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-media {
      max-width: 420px;
      margin-inline: auto;
    }
  }
</style>
