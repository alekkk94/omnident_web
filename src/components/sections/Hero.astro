---
import { getTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';
import Figure from '../Figure.astro';
import { getPath } from '../../i18n/routes';
import heroImage from '../../assets/images/clinic/hero-treatment-room-wide.jpg';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section id="hero" class="hero">
  <div class="container hero-grid">
    <div class="hero-content">
      <span class="eyebrow reveal">{t.hero.eyebrow}</span>
      <h1 class="hero-headline reveal">
        {t.hero.headline}
      </h1>
      <p class="hero-subline reveal">{t.hero.subline}</p>

      <div class="hero-ctas reveal">
        <a class="btn btn-primary" href={getPath(lang, 'contact')}>{t.hero.ctaPrimary}</a>
        <a class="btn btn-outline" href="#services">{t.hero.ctaSecondary}</a>
      </div>
    </div>

    <div class="hero-media reveal">
      <Figure src={heroImage} alt={t.hero.imageAlt} ratio="4 / 5" loading="eager" sizes="(min-width: 900px) 45vw, 90vw" />
    </div>
  </div>

  <a href="#about" class="scroll-hint">
    <span>{t.hero.scrollHint}</span>
    <span class="scroll-hint-line"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
    overflow: hidden;
  }


  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .hero-headline {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    margin-block: 1rem 1.25rem;
  }

  .hero-subline {
    max-width: 46ch;
    color: var(--color-ink-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .hero-media {
    position: relative;
  }

  .scroll-hint {
    display: none;
    position: absolute;
    left: 50%;
    bottom: 0.5rem;
    transform: translateX(-50%);
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .scroll-hint-line {
    width: 1px;
    height: 32px;
    background: linear-gradient(var(--color-primary), transparent);
  }

  @media (min-width: 860px) {
    .scroll-hint {
      display: flex;
    }
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-media {
      max-width: 420px;
      margin-inline: auto;
    }
  }
</style>
