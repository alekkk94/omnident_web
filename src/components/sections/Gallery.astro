---
import { getTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';
import ArtPanel from '../ArtPanel.astro';
import type { IconName } from '../../lib/icons';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const polaroids: { icon: IconName; angle: number }[] = [
  { icon: 'tooth', angle: -4 },
  { icon: 'smile', angle: 3 },
  { icon: 'sparkle', angle: -2 },
  { icon: 'heart', angle: 5 },
  { icon: 'implant', angle: -3 },
  { icon: 'star', angle: 2 },
];
---

<section id="gallery" class="section gallery">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow reveal">{t.gallery.eyebrow}</span>
      <h2 class="reveal">
        {t.gallery.headlineStart}<span class="accent">{t.gallery.headlineAccent}</span>{t.gallery.headlineEnd}
      </h2>
      <p class="gallery-sub reveal">{t.gallery.subheading}</p>
    </div>

    <div class="polaroid-wall">
      {polaroids.map((p) => (
        <div class="polaroid reveal" style={`--angle: ${p.angle}deg;`}>
          <ArtPanel icon={p.icon} ratio="1 / 1" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-sub {
    color: var(--color-ink-muted);
    margin-inline: auto;
  }

  .polaroid-wall {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-block: 1rem;
  }

  .polaroid {
    background: #f4efe4;
    padding: 0.75rem 0.75rem 1.25rem;
    border-radius: 3px;
    box-shadow: 0 18px 30px -14px rgba(0, 0, 0, 0.55);
    transform: rotate(var(--angle));
    transition: transform 0.35s var(--ease-out);
  }

  .polaroid:hover {
    transform: rotate(0deg) scale(1.03);
  }
</style>
