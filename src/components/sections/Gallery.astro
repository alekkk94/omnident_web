---
import { getTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';
import Figure from '../Figure.astro';
import galleryImage1 from '../../assets/images/clinic/gallery-treatment-room-1.jpg';
import galleryImage2 from '../../assets/images/clinic/gallery-treatment-room-2.jpg';
import galleryImage3 from '../../assets/images/clinic/gallery-treatment-chair-teal.jpg';
import galleryImage4 from '../../assets/images/clinic/gallery-waiting-area.jpg';
import galleryImage5 from '../../assets/images/clinic/gallery-equipment-closeup.jpg';
import galleryImage6 from '../../assets/images/clinic/gallery-instruments-macro.jpg';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const images = [
  galleryImage1,
  galleryImage2,
  galleryImage3,
  galleryImage4,
  galleryImage5,
  galleryImage6,
];
---

<section id="gallery" class="section section-alt gallery">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow reveal">{t.gallery.eyebrow}</span>
      <h2 class="reveal">
        {t.gallery.headline}
      </h2>
      <p class="gallery-sub reveal">{t.gallery.subheading}</p>
    </div>

    <div class="gallery-grid">
      {images.map((image, i) => (
        <figure class="gallery-item reveal">
          <Figure src={image} alt={t.gallery.imageAlts[i]} ratio="4 / 3" sizes="(min-width: 900px) 32vw, 90vw" />
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-sub {
    color: var(--color-ink-muted);
    margin-inline: auto;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .gallery-item {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
</style>
