---
import { getTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';
import Figure from '../Figure.astro';
import galleryImage1 from '../../assets/images/clinic/gallery-treatment-room-1.jpg';
import galleryImage2 from '../../assets/images/clinic/gallery-treatment-room-2.jpg';
import galleryImage3 from '../../assets/images/clinic/gallery-treatment-chair-teal.jpg';
import galleryImage4 from '../../assets/images/clinic/gallery-waiting-area.jpg';
import galleryImage5 from '../../assets/images/clinic/gallery-equipment-closeup.jpg';
import galleryImage6 from '../../assets/images/clinic/gallery-instruments-macro.jpg';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const polaroids = [
  { image: galleryImage1, angle: -4 },
  { image: galleryImage2, angle: 3 },
  { image: galleryImage3, angle: -2 },
  { image: galleryImage4, angle: 5 },
  { image: galleryImage5, angle: -3 },
  { image: galleryImage6, angle: 2 },
];
---

<section id="gallery" class="section gallery">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow reveal">{t.gallery.eyebrow}</span>
      <h2 class="reveal">
        {t.gallery.headlineStart}<span class="accent">{t.gallery.headlineAccent}</span>{t.gallery.headlineEnd}
      </h2>
      <p class="gallery-sub reveal">{t.gallery.subheading}</p>
    </div>

    <div class="polaroid-wall">
      {polaroids.map((p, i) => (
        <div class="polaroid reveal" style={`--angle: ${p.angle}deg;`}>
          <Figure src={p.image} alt={t.gallery.imageAlts[i]} ratio="1 / 1" sizes="(min-width: 900px) 30vw, 45vw" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-sub {
    color: var(--color-ink-muted);
    margin-inline: auto;
  }

  .polaroid-wall {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-block: 1rem;
  }

  .polaroid {
    background: #f4efe4;
    padding: 0.75rem 0.75rem 1.25rem;
    border-radius: 3px;
    box-shadow: 0 18px 30px -14px rgba(0, 0, 0, 0.55);
    transform: rotate(var(--angle));
    transition: transform 0.35s var(--ease-out);
  }

  .polaroid:hover {
    transform: rotate(0deg) scale(1.03);
  }
</style>
