---
import { getTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';
import Figure from '../Figure.astro';
import aboutImage from '../../assets/images/clinic/about-treatment-chair-blue.jpg';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section id="about" class="section about">
  <div class="container about-grid">
    <div class="about-media reveal">
      <Figure src={aboutImage} alt={t.about.imageAlt} ratio="1 / 1" sizes="(min-width: 900px) 40vw, 90vw" />
    </div>

    <div class="about-content">
      <span class="eyebrow reveal">{t.about.eyebrow}</span>
      <h2 class="reveal">
        {t.about.headlineStart}<span class="accent">{t.about.headlineAccent}</span>{t.about.headlineEnd}
      </h2>
      <p class="about-philosophy reveal">{t.about.philosophy}</p>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .about-media {
    max-width: 420px;
  }

  .about-content h2 {
    font-size: clamp(2.1rem, 4vw, 3rem);
    margin-bottom: 1.5rem;
  }

  .about-philosophy {
    color: var(--color-ink-muted);
    font-size: 1.05rem;
    line-height: 1.75;
    max-width: 56ch;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-media {
      margin-inline: auto;
    }
  }
</style>

