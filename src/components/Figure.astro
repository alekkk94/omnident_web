---
// Minimal wrapper over astro:assets <Picture> — emits AVIF + WebP with a raster fallback.
// Kept intentionally unstyled; WO-4 owns the visual treatment (borders, radius, shadows).
// `alt` is required — there is no silent empty-alt fallback, by design.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  sizes?: string;
}

const { src, alt, ratio, class: className, loading = 'lazy', sizes } = Astro.props;

if (!alt || !alt.trim()) {
  throw new Error('Figure: `alt` is required and must not be empty.');
}
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  loading={loading}
  decoding={loading === 'eager' ? 'sync' : 'async'}
  sizes={sizes}
  class={className}
  style={ratio ? `aspect-ratio: ${ratio}; object-fit: cover; width: 100%; height: 100%;` : undefined}
/>
